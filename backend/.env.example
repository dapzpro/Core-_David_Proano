# Variables de entorno del backend (se definen en el panel del hosting, p. ej. Render).
# En local NO hace falta ninguna: si no existen, se usan valores por defecto.

# Cadena de conexión de PostgreSQL (Neon, Render, etc.). Si no existe, se usa localhost.
DATABASE_URL=postgresql://usuario:clave@host/basededatos?sslmode=require

# "false" solo si tu PostgreSQL remoto no usa SSL
# DB_SSL=false

# Secreto con el que se firman los tokens JWT (pon una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Correo y contraseña del administrador que se crea al primer arranque
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=pon-una-clave-segura

# URL del frontend desplegado, SIN "/" al final (limita el CORS)
FRONTEND_URL=https://tu-frontend.vercel.app

# Render asigna el puerto solo; en local es 3000
# PORT=3000
